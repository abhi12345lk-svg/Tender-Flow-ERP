# ========================================================
# TenderFlow ERP Frontend Environment Variables (.env.example)
# Copy this file to .env.local or configure in Vercel project settings.
# NEVER put private API secrets or MongoDB credentials in frontend files.
# ========================================================

# Base URL pointing to deployed Render backend API endpoint
# Local development default:
# VITE_API_BASE_URL=http://localhost:5000/api/v1

# Production on Render:
# VITE_API_BASE_URL=https://tenderflow-erp-api.onrender.com/api/v1
VITE_API_BASE_URL=http://localhost:5000/api/v1
