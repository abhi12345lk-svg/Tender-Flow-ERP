# ========================================================
# TenderFlow ERP Server Environment Variables (.env.example)
# Copy this file to .env and configure with your real values.
# NEVER commit real .env files with secrets into git.
# ========================================================

# Server Port
PORT=5000

# Node Environment ('development', 'test', 'production')
NODE_ENV=development

# MongoDB Connection String (Atlas URI or Local MongoDB)
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/tenderflow_erp?retryWrites=true&w=majority
# For Local MongoDB: mongodb://127.0.0.1:27017/tenderflow_erp
MONGODB_URI=mongodb://127.0.0.1:27017/tenderflow_erp

# JWT Secret (Must be a secure random string of at least 32 characters in production)
JWT_SECRET=tenderflow_erp_jwt_secret_dev_key_replace_in_production_32chars!

# JWT Token Expiry (e.g., '1d', '7d')
JWT_EXPIRES_IN=1d

# Allowed Frontend Client Origin(s) for CORS (comma-separated if multiple)
CLIENT_URL=http://localhost:3000,http://localhost:5173

# Admin Initial Seed Credentials (for initial setup only)
INITIAL_ADMIN_EMAIL=admin@tenderflow.gov.in
INITIAL_ADMIN_PASSWORD=AdminSecurePass@2024
INITIAL_ADMIN_NAME=Er. Rajesh Sharma
INITIAL_ADMIN_ROLE=Admin
